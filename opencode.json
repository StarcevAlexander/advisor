{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "zai": {
      "npm": "@ai-sdk/anthropic",
      "name": "Z.AI GLM",
      "options": {
        "baseURL": "https://api.z.ai/api/anthropic",
        "apiKey": "{env:ZAI_API_KEY}"
      },
      "models": {
        "glm-5.3": {}
      }
    }
  },
  "tools": {
    "webfetch": false
  },
  "permission": {
    "edit": { "*": "allow", ".env*": "deny" },
    "bash": {
      "*": "allow",
      "git *": "deny",
      "gh *": "deny",
      "sudo *": "deny",
      "rm *": "deny",
      "curl *": "deny",
      "wget *": "deny"
    }
  }
}
